generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED

  // Solde de crédits Deoflow, dénormalisé pour être lu en une requête.
  //
  // ⚠️ Ne JAMAIS écrire ce champ directement : il doit rester égal à la somme
  // du journal `CreditTransaction`. Tout mouvement passe par
  // `lib/server/credits/` qui met les deux à jour dans une transaction tenue
  // par `lockUserTx` — sans quoi deux générations lancées en même temps
  // liraient le même solde et dépenseraient deux fois le même crédit.
  credits           Int       @default(0)

  // ── Parrainage ────────────────────────────────────────────────────────
  // Code public partagé par cet utilisateur. Attribué PARESSEUSEMENT, à la
  // première ouverture de /affiliation : la majorité des comptes ne parraine
  // jamais, et un code par compte créé encombrerait l'espace de noms pour rien.
  referralCode      String?   @unique

  // Parrain, figé au premier contact. Ne change JAMAIS ensuite : sans ça, un
  // filleul re-cliquant sur un autre lien réattribuerait ses achats passés.
  referredById      String?
  referredBy        User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]    @relation("Referrals")
  referredAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  generations       Generation[]
  creditTransactions CreditTransaction[]
  avatars           Avatar[]
  commissionsEarned    ReferralCommission[] @relation("CommissionEarner")
  commissionsGenerated ReferralCommission[] @relation("CommissionSource")

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]      @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([referredById])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id              String    @id @default(cuid())
  userId          String? // nullable — guest checkout supported
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Int // gross amount, smallest unit
  currency        String    @default("XOF") // ISO 4217
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  metadata        Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey  String?   @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String   @default("XOF")
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Deoflow — génération IA et crédits prépayés
//
// Le produit vend des crédits achetés en mobile money, consommés par des
// appels facturés à l'usage chez kie.ai. D'où deux invariants qui gouvernent
// tout ce bloc :
//
//   1. Le solde ne vit QUE côté serveur. Tant qu'il était dans le
//      localStorage, n'importe qui pouvait s'attribuer un budget de
//      génération en trois lignes de console.
//   2. Tout mouvement de crédit s'écrit dans `CreditTransaction` en même
//      temps que `User.credits`, dans une transaction verrouillée par
//      utilisateur (`lockUserTx`). Le journal est la vérité ; le champ
//      `credits` n'en est qu'un raccourci de lecture.
// ───────────────────────────────────────────────────────────────────────

model Generation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Le catalogue vit dans le code (`lib/deoflow/catalog.ts`) et peut retirer
  // un modèle. On dénormalise donc le nom : une génération de janvier doit
  // rester lisible dans la galerie même si le modèle a disparu depuis.
  modelSlug String
  modelName String
  kind      String // image | video
  mode      String // text | image | motion | frames | references

  // À quoi sert cette génération.
  //
  // Un visage d'avatar sort du même moteur qu'une création, mais ce n'en est
  // pas une : la galerie du créateur est sa production publiable, pas son
  // matériel de travail. `GET /api/generations` filtre donc CREATION par
  // défaut — au niveau de la route, pour que toute surface future hérite du
  // bon comportement sans y penser.
  purpose String @default("CREATION") // CREATION | AVATAR

  // Avatar UTILISÉ dans cette génération — permet d'afficher « avec Awa ».
  // `SetNull` : supprimer un avatar ne doit pas effacer l'historique des
  // images qu'il a servi à produire.
  avatarId String?
  avatar   Avatar? @relation("GenerationAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  // Prompt RÉELLEMENT envoyé au fournisseur, description de l'avatar comprise.
  // C'est ce qui permet de rejouer ou de diagnostiquer une génération des mois
  // plus tard, même si la description de l'avatar a changé depuis.
  prompt          String  @db.Text
  ratio           String?
  durationSeconds Int?
  // Réglages transmis au fournisseur (character_orientation, generate_audio…).
  params          Json?
  // Références envoyées, indexées par clé d'emplacement de l'API :
  // { "input_urls": ["https://…"], "video_urls": ["https://…"] }
  inputs          Json?

  // Crédits débités À LA CRÉATION, avant tout appel au fournisseur. Stocké
  // ici pour que le remboursement d'un échec rende exactement ce qui a été
  // pris, même si le tarif du catalogue a changé entre-temps.
  credits Int

  // PENDING   — débité, pas encore soumis au fournisseur
  // RUNNING   — accepté par le fournisseur, taskId connu
  // SUCCEEDED — résultat recopié chez nous
  // FAILED    — échec, crédits remboursés
  status String @default("PENDING")

  provider       String  @default("kie")
  providerTaskId String? @unique
  providerFamily String? // jobs | veo — décide de l'endpoint de sondage

  // URLs renvoyées par kie.ai. TEMPORAIRES : leur documentation annonce une
  // suppression automatique. Conservées pour le diagnostic, jamais affichées.
  sourceUrls Json?
  // URLs Cloudinary — permanentes. C'est ce que la galerie sert.
  assetUrls  Json?

  failureCode   String?
  failureReason String?

  // Rejeu d'un double-clic : la même clé renvoie la génération déjà créée au
  // lieu d'en lancer — et de facturer — une seconde.
  idempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  transactions CreditTransaction[]

  // `purpose` est dans l'index parce que la galerie filtre dessus à chaque
  // ouverture : sans lui, la requête parcourt toutes les générations de
  // l'utilisateur pour en écarter quelques-unes.
  @@index([userId, purpose, createdAt])
  @@index([status, createdAt])
  @@index([avatarId])
}

// ───────────────────────────────────────────────────────────────────────
// Avatar — l'influenceur réutilisable du créateur.
//
// Ce n'est pas une image, c'est un COUPLE : un visage de référence et une
// description libre. Le visage porte l'identité ; le texte porte ce qu'un
// visage ne peut pas dire — la taille, la corpulence, la garde-robe. Les deux
// sont injectés à chaque génération qui sélectionne l'avatar, si bien que le
// créateur n'a plus à redécrire son personnage.
//
// Le visage est cadré tête-épaules sur FOND BLANC, imposé par le serveur
// (`lib/server/avatars/portrait.ts`). Un visage pris dans un décor traînerait
// ce décor dans toutes les scènes suivantes.
// ───────────────────────────────────────────────────────────────────────

model Avatar {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  // Texte libre : corps, tenue, style, caractère. Injecté avant la scène dans
  // chaque prompt — les modèles pondèrent plus fortement le début.
  description String @db.Text

  // Visage sur fond blanc, URL Cloudinary. DÉNORMALISÉ depuis la génération :
  // l'avatar doit survivre à un nettoyage de la galerie.
  faceUrl String?

  // Génération qui a produit ce visage. Colonne NUE, sans clé étrangère : la
  // supprimer ne doit pas emporter l'avatar. Sert à résoudre `faceUrl` a
  // posteriori quand le créateur a fermé son onglet pendant la génération.
  faceGenerationId String?

  modelSlug String // nano-banana-2 | gpt-image-2

  // PENDING — le visage se génère encore
  // READY   — `faceUrl` est renseignée, l'avatar est utilisable
  // FAILED  — la génération a échoué (crédits déjà remboursés par son service)
  status String @default("PENDING")

  // Le créateur a déclaré disposer des droits sur la photo d'origine. Nul
  // quand l'avatar vient d'un simple prompt.
  photoRightsAckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Générations qui ont UTILISÉ cet avatar. L'autre lien — celle qui a produit
  // le visage — est volontairement une colonne nue, voir ci-dessus.
  usedIn Generation[] @relation("GenerationAvatar")

  @@index([userId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Parrainage — 25 % de chaque achat d'un filleul, à vie.
//
// Registre en ACCUMULATION, jamais un solde. Trois raisons :
//
//   1. La commission naît DANS la transaction qui règle l'achat, verrouillée
//      sur l'ACHETEUR (`withUserCredits`). Écrire au passage un solde sur la
//      ligne du parrain se ferait sans tenir SON verrou : deux filleuls payant
//      en même temps liraient le même solde et l'un des deux gains serait
//      perdu. Une ligne insérée, elle, ne lit rien.
//   2. `orderId @unique` rend le double-crédit impossible au niveau de la
//      base, même si le règlement était rejoué. C'est la deuxième serrure,
//      derrière la réclamation par `updateMany` de `purchases/service.ts`.
//   3. Un litige se règle en relisant les lignes, pas en devinant comment un
//      compteur en est arrivé là.
//
// Le solde disponible se calcule : somme(EARNED) − somme(retraits non annulés).
// Voir `lib/server/referrals/balance.ts`.
// ───────────────────────────────────────────────────────────────────────

model ReferralCommission {
  id String @id @default(cuid())

  // Bénéficiaire — le parrain.
  referrerId String
  referrer   User   @relation("CommissionEarner", fields: [referrerId], references: [id], onDelete: Cascade)

  // Filleul dont l'achat a produit cette commission.
  refereeId String
  referee   User   @relation("CommissionSource", fields: [refereeId], references: [id], onDelete: Cascade)

  // UNE commission par commande, garantie par la base. Le garde-fou ultime.
  orderId     String @unique
  orderAmount Int // montant de l'achat, FCFA

  // Taux FIGÉ au moment du gain, en points de base (2500 = 25 %). Changer le
  // barème demain ne doit pas réécrire ce qui a déjà été gagné.
  rateBps Int
  amount  Int // commission due, FCFA — entier, le franc CFA n'a pas de décimale

  // EARNED   — acquise, comptée dans le solde retirable
  // PAID     — versée (le retrait correspondant est COMPLETED)
  // REVERSED — annulée (remboursement de l'achat, fraude constatée)
  status String @default("EARNED")

  createdAt DateTime @default(now())

  @@index([referrerId, createdAt])
  @@index([refereeId])
  @@index([status])
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SIGNÉ : positif pour un ajout, négatif pour une consommation. Additionner
  // la colonne doit toujours redonner `User.credits`.
  credits  Int
  movement String // PURCHASE | GENERATION | REFUND | ADMIN_ADJUSTMENT
  label    String

  // Solde après ce mouvement. Permet de reconstituer un litige sans rejouer
  // tout le journal, et de repérer une incohérence d'un simple coup d'œil.
  balanceAfter Int

  // Montant payé en FCFA (entier — le franc CFA n'a pas de décimale).
  // Renseigné pour un achat uniquement.
  amountFcfa Int?

  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  orderId      String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([generationId])
}
